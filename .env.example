# tldraw license key (free hobby license or commercial), required in production.
# https://tldraw.dev/pricing
# Read at runtime: changing it needs no rebuild. It is not a secret (tldraw checks it in
# the browser, for the declared domains only), but it can be stored as a sensitive variable.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY is still accepted.
TLDRAW_LICENSE_KEY=

# Postgres (Neon: use the "pooled" URL, with -pooler in the host).
# Empty: local mode, diagrams stay in the browser (no password, no database).
DATABASE_URL=

# App access (cloud mode only)
APP_PASSWORD=
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob (images). Optional: without a token, images are embedded in the document.
BLOB_READ_WRITE_TOKEN=
