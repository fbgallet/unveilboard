# tldraw license key (free hobby license or commercial), required in production.
# https://tldraw.dev/pricing
# Read at runtime: changing it needs no rebuild. It is not a secret (tldraw checks it in
# the browser, for the declared domains only), but it can be stored as a sensitive variable.
# NEXT_PUBLIC_TLDRAW_LICENSE_KEY is still accepted.
TLDRAW_LICENSE_KEY=

# Postgres (Neon: use the "pooled" URL, with -pooler in the host).
# Empty: local mode, diagrams stay in the browser (no password, no database).
DATABASE_URL=

# App access (cloud mode only)
APP_PASSWORD=
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob (images). Optional: without a token, images are embedded in the document.
BLOB_READ_WRITE_TOKEN=

# Public address of this instance, for link previews (social networks, messaging apps).
# Defaults to https://unveilboard.com.
SITE_URL=

# Public sharing (local mode only): anyone can publish a short read-only link (/p/<id>), kept
# 30 days after the last publication. Needs an Upstash Redis store (Vercel Marketplace sets
# KV_REST_API_URL and KV_REST_API_TOKEN; UPSTASH_REDIS_REST_URL / _TOKEN also work).
# Limits: 3 publications per hour and 10 per day per IP address, 200 per day in total.
# The IP address comes from X-Forwarded-For: behind Vercel it cannot be forged; when self-hosting,
# put the app behind a proxy that sets it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# "off" stops new publications at once (existing links stay readable).
SHARING=
# Extra blocked terms, comma-separated, on top of src/lib/share/blocklist.ts.
SHARE_BLOCKLIST=

# Reports ("Report" button on published links), sent by email through Resend. The address never
# reaches the browser. Without a verified domain, Resend's test sender only writes to the address
# of the Resend account: use that address as REPORT_EMAIL.
RESEND_API_KEY=
REPORT_EMAIL=
# Optional sender, once a domain is verified in Resend (e.g. "Unveilboard <reports@unveilboard.com>").
REPORT_FROM=

# Legal notice page (/legal) with privacy information and a contact form (sent through Resend,
# like reports). Without LEGAL_PUBLISHER, there is no legal page and no footer link.
LEGAL_PUBLISHER=
# Publisher links, comma-separated https URLs (e.g. a GitHub profile, a personal site).
LEGAL_LINKS=
# Hosting provider shown on the page. Defaults to Vercel Inc.
LEGAL_HOST=

# AI of this instance (optional). A server-side key, used by the "Ask the AI" button when the user
# picks "This instance's AI". Without it, users can still paste a prompt into their own assistant,
# or connect their own OpenRouter key or local server (those never go through this server).
# - Cloud mode: available to the signed-in user.
# - Local mode (public instance, no password): only with AI_PUBLIC=on and an Upstash store, with
#   per-IP limits (5 per hour, 20 per day, 300 per day in total). Update your legal page if you do.
OPENROUTER_API_KEY=
# Any OpenAI-compatible provider instead of OpenRouter (e.g. http://localhost:11434/v1), with
# AI_API_KEY if it needs one.
AI_BASE_URL=
AI_API_KEY=
# Default model (OpenRouter default: the `default` of src/lib/ai/models.json; required with
# AI_BASE_URL). On OpenRouter, users can also pick one of the models listed in that file, and
# photos or scanned PDFs are transcribed by its `transcription` model.
AI_MODEL=
# Maximum length of an answer, in tokens (default 16000).
AI_MAX_TOKENS=
# "off" if the provider rejects response_format: json_object.
AI_JSON_MODE=
AI_PUBLIC=
