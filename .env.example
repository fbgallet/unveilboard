# Clé de licence tldraw (hobby gratuite ou commerciale), requise en production.
# https://tldraw.dev/pricing
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Postgres (Neon : utiliser l'URL « pooled », avec -pooler dans l'hôte).
# Vide : mode local, les schémas restent dans le navigateur (pas de mot de passe, pas de base).
DATABASE_URL=

# Accès à l'app (mode cloud uniquement)
APP_PASSWORD=
# Au moins 32 caractères aléatoires : openssl rand -base64 48
SESSION_SECRET=

# Vercel Blob (images). Optionnel : sans jeton, les images sont intégrées au document.
BLOB_READ_WRITE_TOKEN=
